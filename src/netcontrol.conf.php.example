/*
 * netcontrol — per-installation overrides.
 *
 * Everything here is optional. The plugin reads the interfaces, the LAN
 * subnet and the captive portal zone from the running configuration, so a
 * standard single-LAN pfSense needs no entries at all.
 *
 * Set a value only when the automatic detection is wrong for your setup,
 * or to protect addresses the plugin cannot know about.
 */

/* Addresses that must never be blocked or throttled, comma separated.
   The firewall's own LAN address is always protected and need not be
   listed. Add switches, access points, hypervisors, NAS, printers. */
// Addresses that must never be blocked or speed-limited.
//
// The firewall's own interface addresses, every gateway it holds, and the
// first address of each managed subnet are protected automatically - you do
// not need to list those. Use this only for what the system cannot work out
// for itself: a switch, an access point, a hypervisor, a server.
// define('NC_OVERRIDE_PROTECTED', '10.0.0.20,10.0.0.250');
//
// A managed switch or access point belongs here even when it also runs a
// DHCP server of its own - two DHCP servers on one LAN will hand out the
// firewall's own address sooner or later. Turn the second one off at the
// device and list the device here so it can never be blocked by mistake.

/* Uncomment any of these if detection picks the wrong interface. */
// define('NC_OVERRIDE_LAN_IF',     'em1');
// define('NC_OVERRIDE_WAN_IF',     'em2');
// define('NC_OVERRIDE_LAN_IP',     '192.168.1.1');
// define('NC_OVERRIDE_LAN_SUBNET', '192.168.1.');
// define('NC_OVERRIDE_CP_ZONE',    'mainlan');

/*
 * A standing speed cap for phones and tablets, in megabits. 0 or unset
 * turns it off.
 *
 * Applied on every tick, so a phone that joins later is caught too. It
 * never overrides a tighter limit set by hand, never touches a computer,
 * and never touches a protected address.
 */
// define('NC_MOBILE_LIMIT', 1);

